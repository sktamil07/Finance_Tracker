# Copy to .env and adjust for your machine. Expo inlines EXPO_PUBLIC_* vars at
# build time. NOTHING here is a secret — the mobile client only needs the API
# origin; auth tokens are obtained at runtime and stored in the device keychain.
#
# The backend listens on port 8098 (see application.yml: SERVER_PORT). Pick the
# value that matches how you run the app:
#   iOS simulator ........ http://localhost:8098/api/v1
#   Android emulator ..... http://10.0.2.2:8098/api/v1
#   Physical device ...... http://<your-machine-LAN-IP>:8098/api/v1   (e.g. 192.168.1.10)
#   Staging / prod ....... https://api.your-domain.tld/api/v1

EXPO_PUBLIC_API_BASE_URL=http://localhost:8098/api/v1
