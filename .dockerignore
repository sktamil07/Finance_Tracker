# Keep the build context small & clean. The mobile/ sources ARE needed now — the
# image builds the Expo web bundle and bakes it into the JAR — but its installed
# and generated directories must stay out (npm ci reinstalls them in the image).
node_modules/
mobile/node_modules/
mobile/dist/
mobile/.expo/
mobile/web-build/

# Build output & IDE
target/
.idea/
*.iml
.mvn/wrapper/maven-wrapper.jar

# VCS & local env
.git/
.gitignore
*.env
.env
.env.*
mobile/.env
mobile/.env.*

# Docs / misc
README.md
*.md
