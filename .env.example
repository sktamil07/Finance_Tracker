# Copy to .env and source it (or export these in your shell) before `./mvnw spring-boot:run`.
# NOTHING here has a default in application.yml except host/port/name — startup fails loudly otherwise.

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finance_tracker
DB_USERNAME=finance
DB_PASSWORD=change-me-locally

# --- JWT signing key ---
# HS256 requires >= 256 bits (32 bytes). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-bytes-of-random-secret-material

# --- CORS: comma-separated web frontend origins ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
SERVER_PORT=8080
